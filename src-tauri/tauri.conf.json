{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "骆耀升老公酱面试助手",
  "version": "0.1.0",
  "identifier": "com.luoyaosheng.mianxu",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "骆耀升老公酱面试助手",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "骆耀升老公酱面试助手",
        "url": "index.html#overlay",
        "width": 420,
        "height": 520,
        "minWidth": 120,
        "minHeight": 80,
        "x": 1200,
        "y": 300,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "alwaysOnTop": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
