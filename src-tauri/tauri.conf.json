{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "骆耀升老公酱面试助手",
  "version": "0.1.0",
  "identifier": "com.luoyaosheng.mianxu",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "骆耀升老公酱面试助手",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "骆耀升老公酱面试助手",
        "url": "index.html#overlay",
        "width": 420,
        "height": 520,
        "minWidth": 200,
        "minHeight": 150,
        "x": 1200,
        "y": 300,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "alwaysOnTop": true,
        "focus": false,
        "maxWidth": 2560,
        "maxHeight": 2560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Mianxu",
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "template": "windows/installer.nsi",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "windows/branding/sidebar.bmp",
        "headerImage": "windows/branding/header.bmp",
        "uninstallerHeaderImage": "windows/branding/uninstall-header.bmp",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/alvinluo-tech/interview-assistant/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2MUU4QjQ1NEFDRDlDQ0UKUldUT25NMUtSWXNlRm93K1lXU2x3T0ovUEhjT2FtaVVlOEhMU1E0L2ExRGRaOGM3M2ljYWVzeFQK"
    }
  }
}
